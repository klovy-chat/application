{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-app",
  "description": "Desktop: Tauri IPC on the hosted web app",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "remote": {
    "urls": [
      "https://app.klovy.chat",
      "https://app.klovy.chat/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-safe-urls",
    "allow-set-unread-badge"
  ]
}
